{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unitoperationrunner",
  "version": "0.1.0",
  "identifier": "com.amsterchem.unitoperationrunner",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Unit Operation Runner",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "copyright": "© 2026 AmsterCHEM",
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
