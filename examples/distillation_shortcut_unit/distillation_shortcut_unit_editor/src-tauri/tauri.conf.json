{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Distillation Shortcut Unit",
  "version": "0.1.3",
  "identifier": "com.amsterchem.distillation-shortcut-unit-editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Distillation Shortcut Unit",
        "width": 600,
        "height": 600,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "copyright": "© 2026 AmsterCHEM",
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
